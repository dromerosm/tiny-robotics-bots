menu "tr_ota home Wi-Fi"
    # The defaults come from environment variables, so no password is in git.
    # scripts/build.sh passes them from the file in WIFI_ENV (see README.md).
    # With no SSID set, the robot joins esp-emu's built-in network.
    config TR_WIFI_SSID_01
        string "First network (SSID)"
        default "$(SSID_01)"
    config TR_WIFI_PASSWORD_01
        string "First network password"
        default "$(PWD_SSID_01)"
    config TR_WIFI_SSID_02
        string "Second network (SSID)"
        default "$(SSID_02)"
    config TR_WIFI_PASSWORD_02
        string "Second network password"
        default "$(PWD_SSID_02)"
    # A fallback, such as a phone's hotspot: used only when neither network
    # above is in range, so at home the robot never takes the phone's data.
    config TR_WIFI_SSID_03
        string "Fallback network (SSID), only when 01 and 02 are not in range"
        default "$(SSID_03)"
    config TR_WIFI_PASSWORD_03
        string "Fallback network password"
        default "$(PWD_SSID_03)"
endmenu
