menu "bala2_link home Wi-Fi"
    # The defaults come from environment variables, so no password is in git.
    # scripts/build.sh passes them from the file in WIFI_ENV (see README.md).
    # With no SSID set (as in CI), the robot makes its own network.
    config BALA2_WIFI_SSID_01
        string "First network (SSID)"
        default "$(SSID_01)"
    config BALA2_WIFI_PASSWORD_01
        string "First network password"
        default "$(PWD_SSID_01)"
    config BALA2_WIFI_SSID_02
        string "Second network (SSID)"
        default "$(SSID_02)"
    config BALA2_WIFI_PASSWORD_02
        string "Second network password"
        default "$(PWD_SSID_02)"
endmenu

config BALA2_LINK_QEMU_ETH
    bool "bala2_link over QEMU's Ethernet card (emulator only)"
    default n
    select ETH_USE_OPENETH
    help
        For builds that run in QEMU, which has no Wi-Fi radio. The link uses
        QEMU's Ethernet card (open_eth) and Wi-Fi stays off. Never set it in
        a build for the robot: the real chip has no such card.
