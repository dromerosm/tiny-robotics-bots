menu "12-talk key server"
    # From environment variables, as the Wi-Fi settings: scripts/build.sh
    # passes them from the file in WIFI_ENV. Never in git.
    config TALK_URL
        string "Key Worker URL (POST /key)"
        default "$(TALK_URL)"
    config TALK_TOKEN
        string "Robot token for the key Worker"
        default "$(TALK_TOKEN)"
endmenu
