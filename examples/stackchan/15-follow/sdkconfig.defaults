CONFIG_IDF_TARGET="esp32s3"
CONFIG_LOG_COLORS=y
# 16 MB flash and two app slots, for updates over Wi-Fi.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../components/tr_ota/partitions.csv"
# A new app must mark itself valid, or the bootloader goes back to the old one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# No /camera.jpg: track.c starts and stops the camera by itself.
CONFIG_TR_WEB_CAMERA=n
# Camera: only the GC0308 driver (smaller, and no probes of other chips on our bus).
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV2640_SUPPORT=n
CONFIG_OV3660_SUPPORT=n
CONFIG_OV3640_SUPPORT=n
CONFIG_OV5640_SUPPORT=n
CONFIG_CAMERA_AF_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
CONFIG_GC0308_SUPPORT=y
# The camera's buffer in internal RAM: 8 KB, not 32 KB, because the echo
# canceller keeps most of that RAM. (Frames straight into PSRAM,
# CONFIG_CAMERA_PSRAM_DMA, saved it all, but the camera timed out on most
# frames.)
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=8192
# Face detection (esp-dl): the small two-stage model (MSR + MNP, 190 KB),
# kept in the app's flash.
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
# 8 MB PSRAM on the CoreS3, for the echo canceller, the audio buffers, the
# camera frames and the face model.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_SPEED_80M=y
# Speed for the echo canceller: code built for speed, and the CPU at 240 MHz.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# An IPv6 link-local address (tr_ota), so stackchan.local resolves at once on
# macOS. Skip the duplicate check: with it the address never became valid.
CONFIG_LWIP_IPV6_DUP_DETECT_ATTEMPTS=0
# TLS for api.openai.com and our key Worker: the certificate bundle, and the
# TLS, Wi-Fi and lwIP buffers in PSRAM, to keep internal RAM free.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
# Our Worker's chain (workers.dev) ends in GTS Root R4 cross-signed by
# GlobalSign Root CA, which is not in the bundle: check GTS Root R4 too.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Allocations above 256 bytes in PSRAM too (2 KB in 14-record): the echo
# canceller keeps 136 KB of internal RAM, and the camera and the face model
# need some of what is left.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
# CPU use per task in GET /talk (to check the echo canceller keeps up).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# A bigger TCP send buffer for the recordings (16 KB, in PSRAM with the
# lwIP buffers): with the default 5.7 KB it was full all the time on a slower
# network, and each piece went up in many small waits.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
# TLS stays as in 12-talk (hardware AES, 4 KB records). While it records,
# hardware AES often fails to get its DMA buffer in internal RAM
# ("esp-aes: Failed to allocate memory", about 24 times in 2 min). The
# write retry in rec.c catches it, and no piece is lost. Two fixes we tried:
# software AES (0 errors, but talks lost real time: 274 of 312 frames, and
# internal RAM fell to 1 KB) and 2 KB records (still 24 errors).
