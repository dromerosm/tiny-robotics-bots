CONFIG_IDF_TARGET="esp32s3"
CONFIG_LOG_COLORS=y
# 16 MB flash and two app slots, for updates over Wi-Fi.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../components/tr_ota/partitions.csv"
# A new app must mark itself valid, or the bootloader goes back to the old one.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# 8 MB PSRAM on the CoreS3, for camera frames. Go on without it if it is not found.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Camera: only the GC0308 driver (smaller, and no probes of other chips on our bus).
CONFIG_OV7670_SUPPORT=n
CONFIG_OV7725_SUPPORT=n
CONFIG_NT99141_SUPPORT=n
CONFIG_OV2640_SUPPORT=n
CONFIG_OV3660_SUPPORT=n
CONFIG_OV3640_SUPPORT=n
CONFIG_OV5640_SUPPORT=n
CONFIG_CAMERA_AF_SUPPORT=n
CONFIG_GC2145_SUPPORT=n
CONFIG_GC032A_SUPPORT=n
CONFIG_BF3005_SUPPORT=n
CONFIG_BF20A6_SUPPORT=n
CONFIG_SC101IOT_SUPPORT=n
CONFIG_SC030IOT_SUPPORT=n
CONFIG_SC031GS_SUPPORT=n
CONFIG_HM1055_SUPPORT=n
CONFIG_HM0360_SUPPORT=n
CONFIG_MEGA_CCM_SUPPORT=n
CONFIG_GC0308_SUPPORT=y
# Face detection (esp-dl): the small two-stage model (MSR + MNP, 190 KB),
# kept in the app's flash.
CONFIG_FLASH_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MSRMNP_S8_V1=y
CONFIG_HUMAN_FACE_DETECT_MODEL_IN_FLASH_RODATA=y
# Speed for the model: code built for speed, and the CPU at 240 MHz.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_SPEED_80M=y
# Light sleep while the robot sleeps (tr_board): the CPU slows down to 80 MHz
# and sleeps between ticks. Wi-Fi stays connected (modem sleep).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
# An IPv6 link-local address (tr_ota), so stackchan.local resolves at once on
# macOS. Skip the duplicate check: with it the address never became valid.
CONFIG_LWIP_IPV6_DUP_DETECT_ATTEMPTS=0
