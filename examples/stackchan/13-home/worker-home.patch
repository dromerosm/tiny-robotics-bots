+// The session for this talk: SESSION, plus the plug tools for profile=home.
+function sessionFor(home) {
+  if (!home) {
+    return SESSION;
+  }
+  const responses = SESSION.delegation.responses;
+  return {
+    ...SESSION,
+    instructions:
+      SESSION.instructions +
+      " Si te piden encender o apagar algo de casa, o cuánto consume, delega la tarea.",
+    delegation: {
+      ...SESSION.delegation,
+      responses: {
+        ...responses,
+        instructions:
+          responses.instructions +
+          " Controlas los enchufes de casa con get_home_status y set_switch. Si set_switch " +
+          "responde needs_confirmation, no lo hagas: di que eso deja al robot sin wifi y pregunta " +
+          "si está seguro. Solo con un sí claro vuelve a llamar con confirmed=true.",
+        tools: [...responses.tools, ...HOME_TOOLS],
+      },
+    },
+  };
+}
+
+// A response.event with a finished function call, for the robot (profile=home).
+function functionCall(data) {
+  try {
+    const m = JSON.parse(data);
+    return m.event?.type === "response.output_item.done" && m.event.item?.type === "function_call";
+  } catch {
+    return false;
+  }
+}
