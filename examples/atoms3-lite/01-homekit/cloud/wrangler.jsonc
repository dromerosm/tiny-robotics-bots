{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-energy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "assets": { "directory": "./public" },
  "d1_databases": [
    // Set database_id after `wrangler d1 create home-energy`.
    { "binding": "DB", "database_name": "home-energy", "database_id": "local-only", "migrations_dir": "migrations" }
  ],
  // The bridge sends with this secret: `wrangler secret put INGEST_TOKEN`.
  // For `wrangler dev`, put INGEST_TOKEN=... in .dev.vars (ignored by git).
  "routes": [{ "pattern": "energy.diegoromero.es", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
