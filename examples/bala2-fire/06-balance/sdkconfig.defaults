CONFIG_IDF_TARGET="esp32"
CONFIG_LOG_COLORS=y
CONFIG_FREERTOS_HZ=1000
# A stuck control loop resets the chip, and the new boot sends speed 0.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=1
# 16 MB flash and two app slots, for updates over Wi-Fi.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../../../components/bala2_link/partitions.csv"
# IPv4 only: nothing here uses IPv6, and the app is about 30 KB smaller.
CONFIG_LWIP_IPV6=n
# mDNS without its console commands: nobody types them here.
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
# Charge mode slows the CPU and lets it sleep while idle (cpu_rest in main.cpp).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
